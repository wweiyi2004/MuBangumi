{
  "name": "mubangumi-homepage",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:pages": "cross-env GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/MuBangumi NEXT_PUBLIC_SITE_URL=https://wweiyi2004.github.io/MuBangumi/ WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/prepare-github-pages.mjs",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:pages": "npm run build:pages && node --test tests/static-export.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:pages",
    "audit:security": "npm audit --audit-level=high --registry=https://registry.npmjs.org",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@cloudflare/vite-plugin": "1.57.1",
    "cross-env": "10.1.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vinext": "1.0.0-beta.11",
    "vite": "8.3.0",
    "wrangler": "4.136.1"
  },
  "type": "module"
}
