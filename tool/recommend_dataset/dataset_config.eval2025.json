{
  "api": {
    "base_url": "https://api.bgm.tv",
    "user_agent": "MuBangumiRecommendDataset/0.1.0 (recommendation dataset collection; personal use; low-rate public API access)",
    "timeout_seconds": 30,
    "max_concurrency": 2,
    "qps": 1.0,
    "max_retries": 5,
    "retry_base_seconds": 1.0,
    "retry_max_seconds": 30.0,
    "retry_jitter_seconds": 1.0
  },
  "subjects": {
    "seed_subject_ids": [],
    "use_calendar": true,
    "year_quarters": [
      [
        2026,
        1
      ],
      [
        2026,
        2
      ]
    ],
    "fetch_related": true,
    "fetch_characters": true,
    "fetch_persons": false,
    "max_offset_per_query": 2000,
    "dry_run_max_subjects": 100
  },
  "interactions": {
    "collection_types": [
      "wish",
      "doing",
      "collect",
      "on_hold",
      "dropped"
    ],
    "page_size": 100,
    "max_pages_per_type": 2,
    "dry_run_max_users": 0
  },
  "splits": {
    "train_end_date": "2025-12-31"
  },
  "privacy": {
    "salt_path": ""
  },
  "output": {
    "data_dir": "data",
    "checkpoint_db": "",
    "failed_requests": "",
    "export_dir": "data/export_eval2025",
    "baseline_dir": "data/baseline_eval2025",
    "als_dir": "data/als_eval2025"
  },
  "evaluation": {
    "strict_temporal": true,
    "allow_dynamic_popularity_features": false,
    "top_k": [
      5,
      10,
      20
    ],
    "negative_profile_weight": 0.2,
    "random_seed": 42
  },
  "content_model": {
    "summary_analyzer": "char",
    "summary_ngram_min": 2,
    "summary_ngram_max": 4,
    "summary_min_df": 2,
    "feature_weights": {
      "tags": 1.0,
      "staff": 0.8,
      "summary": 0.5,
      "voice_actors": 0.3,
      "context": 0.2
    }
  },
  "als_model": {
    "factors": 64,
    "regularization": 0.05,
    "alpha": 2.0,
    "iterations": 20,
    "negative_scales": [
      0.0,
      0.25
    ]
  }
}
